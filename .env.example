# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=finance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finance_db

# ── Database (used by the app directly) ────────────────────────────────────
# For docker-compose: host = "db" (service name)
# For local dev:      host = "localhost"
DATABASE_URL=postgresql+asyncpg://finance:changeme@db:5432/finance_db

# Pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ── Redis ──────────────────────────────────────────────────────────────────
# For docker-compose: host = "redis"
# For local dev:      host = "localhost"
REDIS_URL=redis://redis:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
